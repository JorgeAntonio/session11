# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub (ya está en .gitignore).

# Pública (llega al navegador): solo cosas que no son secretas
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privadas (solo servidor): nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
